# Public Vite env — baked into the client bundle at build time.
# Never commit real keys. Copy this file to .env.local for local development.

# Google Maps (Places Autocomplete + Directions). Restrict the key to HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=

# EmailJS — two templates (client confirmation + business/job notification)
VITE_EMAILJS_SERVICE_ID=service_YOUR_ID
VITE_EMAILJS_CLIENT_TEMPLATE_ID=template_CLIENT_ID
VITE_EMAILJS_BUSINESS_TEMPLATE_ID=template_BUSINESS_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# WhatsApp Business number in international format, digits only (e.g. 61412345678)
VITE_WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER

# Stripe Payment Link (AUD). Leave blank until you create a live/test Payment Link.
VITE_STRIPE_PAYMENT_LINK=
# Optional: Stripe.js publishable key for a later Checkout embed (pk_test_... / pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=
