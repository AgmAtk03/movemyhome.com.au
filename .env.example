# Copy to .env.local for Vite, and set the same names in the Vercel project.
# Never commit real values. Production is HTTPS only (localhost HTTP is fine for Stripe test mode).

# --- Server only (never prefix these with VITE_ or REACT_APP_) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Publishable pk_ keys only. Not required — Checkout is hosted by Stripe.
STRIPE_PUBLISHABLE_KEY=

# Public site origin used for Stripe success/cancel redirects (no trailing slash).
# Canonical production UI is the Netlify apex (www redirects there).
# Example: https://movemyhome.com.au
# Preview fallback: Vercel’s VERCEL_URL is used if this is empty.
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=
# Checkout/verify call this origin if Netlify’s /api proxy is not applied.
# Default in code is https://aama-removals.vercel.app
VITE_API_BASE=

# --- Client (Vite bakes VITE_* into the browser bundle) ---
VITE_GOOGLE_MAPS_API_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CLIENT_TEMPLATE_ID=
VITE_EMAILJS_BUSINESS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Member 5% off emails. Same EmailJS Gmail service as paid booking mail.
# Set the real template ID from the EmailJS dashboard (do not invent one).
VITE_EMAILJS_MEMBER_TEMPLATE_ID=
# Public booking line (shown on the site). Not a secret.
VITE_WHATSAPP_NUMBER=61410721370

# Owner contact / legal. Phone is the public booking mobile.
# Do not invent licences, ABN, or trading names.
VITE_LEGAL_TRADING_NAME=
# Bookings inbox. Server member + job-sheet mail falls back to removalsmyhome@gmail.com.
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=0410 721 370
VITE_COMPANY_WEBSITE=
VITE_ABN=

# Server copy of the member EmailJS template. Required on Vercel production for signup mail.
# Leave blank until you create the template (To: {{to_email}}) — then paste template_XXXX here.
EMAILJS_MEMBER_TEMPLATE_ID=
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional stable secret for STUDENT5-XXXXXXXX codes. If empty, EMAILJS_PRIVATE_KEY is used.
# Keep this stable — rotating it changes HMAC codes for emails that were never stored on Stripe.
MEMBER_CODE_SECRET=
# Optional override; code already falls back to removalsmyhome@gmail.com.
BOOKINGS_INBOX=
# Optional. Live 7-Eleven diesel AUD per litre override (e.g. 1.95).
# If unset, GET /api/diesel-price uses the 11-Seven NSW 7-Eleven diesel feed.
# If that fetch fails, fuel shows as TBC and is not guessed.
SEVEN_ELEVEN_DIESEL_AUD_PER_L=
