# Copy to .env.local for Vite, and set the same names in the Vercel project.
# Never commit real values. Production is HTTPS only (localhost HTTP is fine for Stripe test mode).

# --- Server only (never prefix these with VITE_ or REACT_APP_) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Publishable pk_ keys only. Not required — Checkout is hosted by Stripe.
STRIPE_PUBLISHABLE_KEY=

# Public site origin used for Stripe success/cancel redirects (no trailing slash).
# Canonical production UI is the Netlify apex (www redirects there).
# Example: https://movemyhome.com.au
# Preview fallback: Vercel’s VERCEL_URL is used if this is empty.
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=

# --- Client (Vite bakes VITE_* into the browser bundle) ---
VITE_GOOGLE_MAPS_API_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CLIENT_TEMPLATE_ID=
VITE_EMAILJS_BUSINESS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optional. Only used by POST /api/member-signup. Leave blank to keep membership local-only.
VITE_EMAILJS_MEMBER_TEMPLATE_ID=
VITE_WHATSAPP_NUMBER=

# Owner contact / legal placeholders — do not invent real credentials.
VITE_LEGAL_TRADING_NAME=
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_WEBSITE=
VITE_ABN=

# Optional. Only used by POST /api/member-signup if you create a dedicated EmailJS template.
# Leave blank to keep membership sign-ups on-device (honest local save).
EMAILJS_MEMBER_TEMPLATE_ID=
# Optional EmailJS private key for the webhook (server). Prefer this over the public key alone.
EMAILJS_PRIVATE_KEY=
